# All values are non-secret defaults. Copy to .env if you want to override (never commit .env).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b          # fallback for low RAM: any smaller model you have pulled
OLLAMA_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=10
MAX_MESSAGES_PER_IMPORT=5000
MAX_MESSAGES_PER_BATCH=20
SESSION_TTL_MINUTES=60
DEFAULT_EVENT_MINUTES=30
DEMO_MODE=false
